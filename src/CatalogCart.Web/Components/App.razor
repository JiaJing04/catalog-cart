<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#039BE5" />
    <base href="/" />
    @* Montserrat matches the mockup. If it can't load (offline), the CSS falls back to system fonts. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/png" href="img/placeholder.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Interactive Server without prerendering: each page loads its data once, after the
    // live connection is up, instead of twice (prerender + interactive).
    private static readonly IComponentRenderMode PageRenderMode = new InteractiveServerRenderMode(prerender: false);
}
